{
  "name": "@vantio/agent-sdk",
  "version": "0.2.0",
  "description": "See what your AI agents are doing. Two lines of code.",
  "license": "MIT",
  "author": "Vantio AI, Inc.",
  "homepage": "https://vantio.ai/developers",
  "repository": {
    "type": "git",
    "url": "https://github.com/vantioai/vantio-open-core.git",
    "directory": "packages/vantio-agent-sdk"
  },
  "bugs": { "url": "https://github.com/vantioai/vantio-open-core/issues" },
  "keywords": ["vantio", "ai", "agent", "sdk", "observability", "governance", "tracing", "langchain", "openai"],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.esm.json --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
