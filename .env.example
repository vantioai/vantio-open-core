# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Settings → API → service_role (keep secret)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... # Settings → API → anon/public

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...           # Developers → API keys
STRIPE_WEBHOOK_SECRET=whsec_...        # Developers → Webhooks → signing secret
STRIPE_SMB_PRICE_ID=price_...          # Products → SMB PRO → price ID

# ─── Upstash Redis (rate limiting) ───────────────────────────
# Create free database at upstash.com → copy REST URL + token
UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ─── Enterprise (optional) ───────────────────────────────────
# Calendly URL for the /auth/enterprise "Schedule a Call" tab.
# If not set, the tab is hidden and only the contact form is shown.
# Example: https://calendly.com/yourname/enterprise-intro
NEXT_PUBLIC_CALENDLY_URL=

# ─── Enterprise Contact ──────────────────────────────────────
# Calendly booking URL for the enterprise /auth/enterprise page.
# If unset, the "Schedule a Call" tab is hidden and only the contact form shows.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/enterprise

# ─── Slack Alerting ──────────────────────────────────────────
# api.slack.com/apps → Incoming Webhooks → Add to workspace → copy URL
# Vantio's INTERNAL telemetry/alerts channel — NOT used for signups or per-tenant alerts.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# Dedicated channel for signup/lead notifications (waitlist + enterprise contact form).
# Separate from SLACK_WEBHOOK_URL so signups never hit the telemetry channel (no fallback).
SLACK_SIGNUPS_WEBHOOK_URL=https://hooks.slack.com/services/aaa/bbb/ccc
# Optional — set in Supabase webhook config to verify requests
SUPABASE_WEBHOOK_SECRET=a-random-secret-string

# ─── Email Alerting (Resend) ─────────────────────────────────
# Resend API key for per-tenant anomaly alert emails. If unset, email alerts are a no-op.
RESEND_API_KEY=re_...
# From address for alert emails (defaults to alerts@vantio.ai when unset).
ALERT_FROM_EMAIL=alerts@vantio.ai

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com   # no trailing slash

# ─── Stripe webhook events to enable in Stripe Dashboard ─────
# Developers → Webhooks → Add endpoint → select EXACTLY these events:
#   checkout.session.completed
#   customer.subscription.updated
#   customer.subscription.deleted
