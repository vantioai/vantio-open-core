generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TelemetryLog {
  id                  String   @id @default(cuid())
  agentId             String
  executionTimeMs     Int
  tokensConsumed      Int
  modelIdentifier     String
  systemAction        String
  deterministicStatus String
  createdAt           DateTime @default(now())
}

model EnterpriseUser {
  id            String        @id @default(cuid())
  email         String        @unique
  domain        String
  role          String        @default("operator")
  samlId        String?       @unique
  quarantineLog String?
  threads       ChatThread[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  user      EnterpriseUser @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime   @default(now())
}
