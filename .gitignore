# Workspace-level gitignore for vantio-open-core monorepo
node_modules/
.env
.env.*
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
apps/web/.next/
apps/web/out/
apps/web/build/
apps/web/next-env.d.ts
apps/web/tsconfig.tsbuildinfo

# TypeScript build output for packages (keep dist for workspace consumers)
packages/*/dist/

# CLI build output
apps/cli/dist/
